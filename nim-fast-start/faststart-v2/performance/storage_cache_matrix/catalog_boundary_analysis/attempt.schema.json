{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archvteams.nebius.ai/schemas/catalog-boundary-storage-attempt-v2.json",
  "title": "Catalog-boundary storage attempt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_manifest_sha256", "evidence_classification", "attempt_id", "request_id", "cache_state", "demand_label", "target", "starting_state", "request", "clock_binding", "request_slo_binding", "ownership_binding", "pre_t0_investment", "operations", "accounting", "concurrency", "terminal", "cleanup", "supporting_evidence"],
  "properties": {
    "schema": {"const": "archvteams.nebius.ai/catalog-boundary-storage-attempt/v2"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_classification": {"enum": ["measured-live-product-slo", "synthetic-contract-smoke-not-performance-evidence"]},
    "attempt_id": {"$ref": "#/$defs/id"},
    "request_id": {"$ref": "#/$defs/id"},
    "cache_state": {"enum": ["A_materialized_hit", "B_node_seed_post_t0_materialization", "C_remote_miss_post_t0", "D_active_a_to_b_reclaim"]},
    "demand_label": {"enum": ["cache_hit", "unknown_model_cold_start", "active_a_to_b_switch"]},
    "target": {"$ref": "#/$defs/target"},
    "starting_state": {"$ref": "#/$defs/startingState"},
    "request": {"$ref": "#/$defs/request"},
    "clock_binding": {"$ref": "#/$defs/clock"},
    "request_slo_binding": {"$ref": "#/$defs/requestSloBinding"},
    "ownership_binding": {"$ref": "#/$defs/ownershipBinding"},
    "pre_t0_investment": {"$ref": "#/$defs/investment"},
    "operations": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/operation"}},
    "accounting": {"$ref": "#/$defs/accounting"},
    "concurrency": {"$ref": "#/$defs/concurrency"},
    "terminal": {"$ref": "#/$defs/terminal"},
    "cleanup": {"$ref": "#/$defs/cleanup"},
    "supporting_evidence": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 0},
    "nonnegative": {"type": "number", "minimum": 0},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_version", "artifact_id", "artifact_version", "artifact_sha256", "artifact_bytes"],
      "properties": {
        "model_id": {"$ref": "#/$defs/id"},
        "model_version": {"$ref": "#/$defs/id"},
        "artifact_id": {"$ref": "#/$defs/id"},
        "artifact_version": {"$ref": "#/$defs/id"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "activeModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_version"],
      "properties": {"model_id": {"$ref": "#/$defs/id"}, "model_version": {"$ref": "#/$defs/id"}}
    },
    "startingState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_materialized", "immutable_node_local_seed_present", "remote_artifact_required", "target_source", "active_model"],
      "properties": {
        "target_materialized": {"type": "boolean"},
        "immutable_node_local_seed_present": {"type": "boolean"},
        "remote_artifact_required": {"type": "boolean"},
        "target_source": {"enum": ["materialized_generation", "immutable_node_local_seed", "immutable_remote_artifact"]},
        "active_model": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/activeModel"}]}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t0_boundary", "accepted_at_utc", "accepted_monotonic_ns", "input_id", "input_sha256", "input_bytes"],
      "properties": {
        "t0_boundary": {"const": "external-client-request-accepted/v1"},
        "accepted_at_utc": {"type": "string"},
        "accepted_monotonic_ns": {"type": "integer", "minimum": 1},
        "input_id": {"$ref": "#/$defs/id"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "input_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorder_id", "clock_id", "boot_id", "utc_sync_source", "max_error_ms", "timestamp_source"],
      "properties": {
        "recorder_id": {"$ref": "#/$defs/id"},
        "clock_id": {"$ref": "#/$defs/id"},
        "boot_id": {"$ref": "#/$defs/id"},
        "utc_sync_source": {"$ref": "#/$defs/id"},
        "max_error_ms": {"$ref": "#/$defs/nonnegative"},
        "timestamp_source": {"const": "external-request-slo-recorder-monotonic/v1"}
      }
    },
    "requestSloBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_path", "ledger_path", "trace_sha256", "ledger_sha256", "trace_id", "ledger_id", "request_id", "attempt_id"],
      "properties": {
        "trace_path": {"type": "string"}, "ledger_path": {"type": "string"},
        "trace_sha256": {"$ref": "#/$defs/sha256"}, "ledger_sha256": {"$ref": "#/$defs/sha256"},
        "trace_id": {"$ref": "#/$defs/id"}, "ledger_id": {"$ref": "#/$defs/id"},
        "request_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}
      }
    },
    "ownershipBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "receipt_id"],
      "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "receipt_id": {"$ref": "#/$defs/id"}}
    },
    "investment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_available_monotonic_ns", "source_age_seconds", "residency_medium", "residency_bytes", "residency_rate_usd_per_gib_month", "residency_cost_usd", "prehydration_bytes", "prehydration_cost_usd", "prehydration_cost_status", "price_source_commit", "included_in_request_totals"],
      "properties": {
        "source_available_monotonic_ns": {"type": "integer", "minimum": 1},
        "source_age_seconds": {"$ref": "#/$defs/nonnegative"},
        "residency_medium": {"enum": ["network_ssd", "object_storage"]},
        "residency_bytes": {"type": "integer", "minimum": 1},
        "residency_rate_usd_per_gib_month": {"$ref": "#/$defs/nonnegative"},
        "residency_cost_usd": {"$ref": "#/$defs/nonnegative"},
        "prehydration_bytes": {"type": "integer", "minimum": 1},
        "prehydration_cost_usd": {"type": "null"},
        "prehydration_cost_status": {"const": "not-measured-no-live-receipt"},
        "price_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "included_in_request_totals": {"const": false}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outcome", "started_monotonic_ns", "finished_monotonic_ns", "logical_bytes", "bytes_read", "bytes_written", "bytes_network", "bytes_deleted", "slo_bytes_moved", "reason", "evidence_ref"],
      "properties": {
        "name": {"enum": ["catalog_selection", "queue", "drain", "gpu_release", "eviction", "placement", "artifact_fetch", "clone", "materialization", "hash", "first_read"]},
        "outcome": {"enum": ["completed", "failed", "skipped"]},
        "started_monotonic_ns": {"type": ["integer", "null"], "minimum": 1},
        "finished_monotonic_ns": {"type": ["integer", "null"], "minimum": 1},
        "logical_bytes": {"$ref": "#/$defs/bytes"}, "bytes_read": {"$ref": "#/$defs/bytes"},
        "bytes_written": {"$ref": "#/$defs/bytes"}, "bytes_network": {"$ref": "#/$defs/bytes"},
        "bytes_deleted": {"$ref": "#/$defs/bytes"}, "slo_bytes_moved": {"$ref": "#/$defs/bytes"},
        "reason": {"type": "string", "minLength": 1},
        "evidence_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes_read_total", "bytes_written_total", "bytes_network_total", "bytes_deleted_total", "physical_bytes_total", "operation_slo_bytes_moved_total", "request_slo_bytes_moved_total", "request_slo_cost_usd"],
      "properties": {
        "bytes_read_total": {"$ref": "#/$defs/bytes"}, "bytes_written_total": {"$ref": "#/$defs/bytes"},
        "bytes_network_total": {"$ref": "#/$defs/bytes"}, "bytes_deleted_total": {"$ref": "#/$defs/bytes"},
        "physical_bytes_total": {"$ref": "#/$defs/bytes"}, "operation_slo_bytes_moved_total": {"$ref": "#/$defs/bytes"},
        "request_slo_bytes_moved_total": {"$ref": "#/$defs/bytes"}, "request_slo_cost_usd": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "peer_attempt_ids", "mutable_namespace_id", "source_read_only"],
      "properties": {
        "group_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "peer_attempt_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "mutable_namespace_id": {"$ref": "#/$defs/id"}, "source_read_only": {"const": true}
      }
    },
    "terminal": {
      "type": "object", "additionalProperties": false,
      "required": ["success", "failure_class", "observed_monotonic_ns"],
      "properties": {"success": {"type": "boolean"}, "failure_class": {"type": ["string", "null"]}, "observed_monotonic_ns": {"type": "integer", "minimum": 1}}
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["generation_id", "generation_uid", "writable_resource_uid", "final_state", "dirty", "reusable", "verified_absent", "evidence_ref"],
      "properties": {
        "generation_id": {"$ref": "#/$defs/id"}, "generation_uid": {"$ref": "#/$defs/id"},
        "writable_resource_uid": {"$ref": "#/$defs/id"}, "final_state": {"enum": ["ABSENT", "SEALED_RETAINED"]},
        "dirty": {"type": "boolean"}, "reusable": {"type": "boolean"}, "verified_absent": {"type": "boolean"},
        "evidence_ref": {"$ref": "#/$defs/id"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "sha256", "receipt_id"],
      "properties": {"kind": {"enum": ["ownership", "operation", "cleanup"]}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "receipt_id": {"$ref": "#/$defs/id"}}
    }
  }
}
