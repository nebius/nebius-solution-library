{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archvteams.nebius.ai/schemas/catalog-boundary-source-manifest-v1.json",
  "title": "Catalog-boundary source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at_utc", "evidence_classification", "request_slo", "catalog", "cost_source", "boltz_external_tmp", "execution_gate"],
  "properties": {
    "schema": {"const": "archvteams.nebius.ai/catalog-boundary-source-manifest/v1"},
    "created_at_utc": {"type": "string"},
    "evidence_classification": {"const": "offline-source-pinned-analysis-not-performance-evidence"},
    "request_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrated_commit", "reviewed_commit", "t0_boundary", "terminal_boundary", "files"],
      "properties": {
        "integrated_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reviewed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "t0_boundary": {"const": "external-client-request-accepted/v1"},
        "terminal_boundary": {"const": "first-complete-semantically-valid-response/v1"},
        "files": {"$ref": "#/$defs/filePins"}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "path", "sha256", "catalog_version", "row_count", "canonical_model_count", "known_canonical_model_count", "known_canonical_bytes", "known_canonical_median_bytes", "known_canonical_p90_bytes", "row_storage_low_bytes", "row_storage_high_bytes", "row_storage_high_is_planning_ceiling"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "catalog_version": {"type": "string"},
        "row_count": {"type": "integer", "minimum": 1},
        "canonical_model_count": {"type": "integer", "minimum": 1},
        "known_canonical_model_count": {"type": "integer", "minimum": 1},
        "known_canonical_bytes": {"type": "integer", "minimum": 1},
        "known_canonical_median_bytes": {"type": "integer", "minimum": 1},
        "known_canonical_p90_bytes": {"type": "integer", "minimum": 1},
        "row_storage_low_bytes": {"type": "integer", "minimum": 1},
        "row_storage_high_bytes": {"type": "integer", "minimum": 1},
        "row_storage_high_is_planning_ceiling": {"const": true}
      }
    },
    "cost_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "path", "sha256", "profile", "price_observed_at", "network_ssd_usd_per_gib_month", "object_storage_usd_per_gib_month", "price_source"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "profile": {"const": "h100-single"},
        "price_observed_at": {"type": "string"},
        "network_ssd_usd_per_gib_month": {"const": "0.071"},
        "object_storage_usd_per_gib_month": {"const": "0.0147"},
        "price_source": {"type": "string"}
      }
    },
    "boltz_external_tmp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "files", "status_observation"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "files": {"$ref": "#/$defs/filePins"},
        "status_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_path", "text", "text_sha256", "bytes_per_attempt", "elapsed_seconds_range", "classification", "raw_attempt_receipts_present_in_this_package"],
          "properties": {
            "source_path": {"type": "string"},
            "text": {"type": "string"},
            "text_sha256": {"$ref": "#/$defs/sha256"},
            "bytes_per_attempt": {"const": 1826220898},
            "elapsed_seconds_range": {"const": [440, 442]},
            "classification": {"const": "prepared-clone-evidence-not-unknown-model-demand-startup"},
            "raw_attempt_receipts_present_in_this_package": {"const": false}
          }
        }
      }
    },
    "execution_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live_execution_permitted", "created_resource_ids", "required_before_execution", "local_nvme"],
      "properties": {
        "live_execution_permitted": {"const": false},
        "created_resource_ids": {"const": []},
        "required_before_execution": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "local_nvme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "substitution_permitted"],
          "properties": {
            "status": {"const": "unavailable-entitlement-not-proven"},
            "substitution_permitted": {"const": false}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "filePins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  }
}
