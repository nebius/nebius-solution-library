{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-switch-kubernetes-node-demand/v1",
  "title": "Post-T0 Kubernetes GPU node-group demand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lease_id",
    "attempt_id",
    "accepted_event_sha256",
    "t0_observed_at_utc",
    "t0_observed_monotonic_ns"
  ],
  "properties": {
    "schema_version": {"const": "catalog-switch-kubernetes-node-demand/v1"},
    "lease_id": {"type": "string"},
    "attempt_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "accepted_event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "t0_observed_at_utc": {"type": "string", "format": "date-time"},
    "t0_observed_monotonic_ns": {"type": "integer", "minimum": 1}
  }
}
