{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-switch-kubernetes-lease-request/v3",
  "title": "Catalog switch Kubernetes lease request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lease_id",
    "task_id",
    "owner",
    "cleanup_owner",
    "purpose",
    "campaign_arm",
    "project_id",
    "region",
    "nebius_profile",
    "authority_identity",
    "cluster_version",
    "node_group_profile",
    "expected_duration_hours",
    "ttl_hours",
    "cleanup_deadline_utc",
    "hard_cost_cap_usd",
    "artifact_storage",
    "metric_contract_sha256",
    "trace_id",
    "trace_sha256",
    "allowed_scenarios",
    "model_input_sha256s",
    "model_request_bindings",
    "accepted_event_authority_id",
    "private_runner_receipt",
    "cleanup_plan"
  ],
  "properties": {
    "schema_version": {"const": "catalog-switch-kubernetes-lease-request/v3"},
    "lease_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$"},
    "owner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$"},
    "cleanup_owner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$"},
    "purpose": {"type": "string", "minLength": 20},
    "campaign_arm": {"enum": ["A_prepared_node", "B_new_preemptible_node"]},
    "project_id": {"type": "string"},
    "region": {"type": "string"},
    "nebius_profile": {"const": "sandbox"},
    "authority_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "parent_id"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "parent_id": {"type": "string", "minLength": 1}
      }
    },
    "cluster_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "node_group_profile": {"type": "string"},
    "expected_duration_hours": {"type": ["string", "number"]},
    "ttl_hours": {"type": "integer", "minimum": 1},
    "cleanup_deadline_utc": {"type": "string", "format": "date-time"},
    "hard_cost_cap_usd": {"type": ["string", "number"]},
    "artifact_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_size_gib"],
      "properties": {"max_size_gib": {"type": "integer", "minimum": 1, "maximum": 1024}}
    },
    "metric_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trace_id": {"type": "string", "minLength": 1},
    "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allowed_scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["same_model_hot", "idle_local", "a_to_b_local", "a_to_b_remote", "checkpoint_fallback", "capacity_miss"]}
    },
    "model_input_sha256s": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "model_request_bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "input"],
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_id", "model_version", "artifact_id", "artifact_version", "artifact_sha256"],
            "properties": {
              "model_id": {"type": "string", "minLength": 1},
              "model_version": {"type": "string", "minLength": 1},
              "artifact_id": {"type": "string", "minLength": 1},
              "artifact_version": {"type": "string", "minLength": 1},
              "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workload_id", "input_id", "payload_sha256", "input_bytes"],
            "properties": {
              "workload_id": {"type": "string", "minLength": 1},
              "input_id": {"type": "string", "minLength": 1},
              "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "input_bytes": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "accepted_event_authority_id": {"type": "string", "minLength": 1},
    "private_runner_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path", "sha256", "reviewed_commit"],
      "properties": {
        "status": {"enum": ["PENDING_CONSUMER_PROOF", "REVIEWED_ACTIVE"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "reviewed_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "cleanup_plan": {"type": "string", "minLength": 20}
  }
}
