{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-switch-kubernetes-resource-lease/v4",
  "title": "Catalog switch Kubernetes resource lease v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backend_version",
    "event_schema_version",
    "lease_id",
    "request_sha256",
    "plan_sha256",
    "request",
    "prefix",
    "project_id",
    "region",
    "state",
    "created_at",
    "expires_at",
    "labels",
    "signing_authority",
    "profile_snapshot",
    "profile_sha256",
    "accepted_event_authority",
    "accepted_event_authority_sha256",
    "live_creation_gates",
    "cost_estimate",
    "resource_graph",
    "resources",
    "resource_create_operations",
    "cluster_id",
    "node_group_ids",
    "node_ids",
    "kubeconfig_path",
    "kubernetes_context",
    "api_server",
    "gpu_product",
    "preemptible",
    "readiness_timestamps",
    "isolation_proof",
    "demand",
    "attempts",
    "failures",
    "lifecycle_events",
    "cleanup_plan"
  ],
  "properties": {
    "schema_version": {"const": "catalog-switch-kubernetes-resource-lease/v4"},
    "backend_version": {"const": "nebius-managed-kubernetes/v3"},
    "event_schema_version": {"const": "catalog-switch-kubernetes-lifecycle-events/v1"},
    "lease_id": {"type": "string"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request": {"type": "object"},
    "prefix": {"type": "string", "pattern": "^mlsp-csw-"},
    "project_id": {"type": "string"},
    "region": {"type": "string"},
    "state": {
      "enum": [
        "PLANNED",
        "CONTROL_PLANE_CREATING",
        "CONTROL_PLANE_FAILED",
        "SUPPORT_ACTIVE_NO_GPU_NODE_GROUP",
        "DEMAND_RECORDED",
        "GPU_CAPACITY_FAILED",
        "GPU_CREATE_FAILED",
        "ACTIVE",
        "ACTIVE_ATTEMPT",
        "ATTEMPT_CLEANING",
        "ATTEMPT_CLEANUP_FAILED",
        "CLEANING",
        "CLEANUP_FAILED",
        "RELEASED"
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "signing_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "public_key_base64", "private_key_path", "private_key_contents_recorded"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "public_key_base64": {"type": "string", "minLength": 40},
        "private_key_path": {"type": "string"},
        "private_key_contents_recorded": {"const": false}
      }
    },
    "profile_snapshot": {"type": "object"},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "accepted_event_authority": {"type": "object"},
    "accepted_event_authority_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "live_creation_gates": {"type": "object"},
    "cost_estimate": {"type": "object"},
    "resource_graph": {"type": "array", "items": {"type": "object"}},
    "resources": {"type": "array", "items": {"type": "object"}},
    "resource_create_operations": {"type": "array", "items": {"type": "object"}},
    "cluster_id": {"type": ["string", "null"]},
    "node_group_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 1},
    "node_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 1},
    "kubeconfig_path": {"type": "string"},
    "kubernetes_context": {"type": "string"},
    "api_server": {"type": ["string", "null"]},
    "gpu_product": {"type": "string"},
    "preemptible": {"const": true},
    "readiness_timestamps": {"type": "object"},
    "isolation_proof": {"type": ["object", "null"]},
    "demand": {"type": ["object", "null"]},
    "attempts": {"type": "array", "items": {"type": "object"}},
    "failures": {"type": "array", "items": {"type": "object"}},
    "lifecycle_events": {"type": "array", "items": {"type": "object"}},
    "cleanup_plan": {"type": "object"},
    "preflight": {"type": "object"},
    "signing_key_cleanup": {"type": "object"},
    "released_at": {"type": "string", "format": "date-time"}
  }
}
