{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebius.example/catalog-switch-resource-lease-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "cost_estimate": {"type": "object"},
    "create_intents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "dispatched_at": {"format": "date-time", "type": "string"},
          "intent_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "kind": {"type": "string"},
          "name": {"type": "string"},
          "parent_id": {"type": "string"},
          "payload_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "resolved_at": {"type": ["null", "string"]},
          "resource_id": {"type": ["null", "string"]},
          "state": {"enum": ["DISPATCHED", "RESOLVED"]}
        },
        "required": [
          "intent_id", "kind", "name", "parent_id", "payload_sha256", "state",
          "dispatched_at", "resolved_at", "resource_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "created_at": {"format": "date-time", "type": "string"},
    "events": {"items": {"type": "object"}, "type": "array"},
    "external_references": {"items": {"type": "object"}, "type": "array"},
    "expires_at": {"format": "date-time", "type": "string"},
    "health_proof": {"type": ["null", "object"]},
    "isolation_proof": {"type": ["null", "object"]},
    "labels": {"additionalProperties": {"type": "string"}, "type": "object"},
    "live_authorization": {"type": "object"},
    "lease_id": {"pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$", "type": "string"},
    "planned_resources": {"items": {"type": "object"}, "type": "array"},
    "preflight": {"type": "object"},
    "prefix": {"pattern": "^mlsp-csw-", "type": "string"},
    "profile_snapshot": {"type": "object"},
    "released_at": {"format": "date-time", "type": "string"},
    "request": {"type": "object"},
    "request_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "resources": {"items": {"type": "object"}, "type": "array"},
    "runtime_gate": {"type": "object"},
    "schema_version": {"const": "catalog-switch-resource-lease/v1"},
    "state": {
      "enum": ["PLANNED", "CREATING", "ACTIVE", "FAILED", "CLEANING", "CLEANUP_FAILED", "RELEASED"]
    }
  },
  "required": [
    "schema_version", "lease_id", "request_sha256", "request", "prefix", "state",
    "created_at", "expires_at", "labels", "profile_snapshot", "cost_estimate",
    "planned_resources", "resources", "health_proof", "events"
  ],
  "title": "Catalog switch resource lease",
  "type": "object"
}
