{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebius.ai/catalog-switch/internal-live-authorization-v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "authorization_id": {"const": "internal-qwen3-h100-scout-v2-20260819"},
    "authorized_at": {"format": "date-time", "type": "string"},
    "authorized_by": {"const": "explicit-user-manager-intervention-20260819"},
    "bearer_token_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "bootstrap_artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {"pattern": "^catalog-switch/cerebrium-comparator/live/", "type": "string"},
          "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "target": {"pattern": "^/opt/catswitch/", "type": "string"}
        },
        "required": ["path", "sha256", "target"],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "campaign": {
      "additionalProperties": false,
      "properties": {
        "arm_id": {"const": "internal-qwen3-new-target-matched"},
        "cold_attempts": {"const": 3},
        "cold_classification": {"const": "process-cold-artifact-hit"},
        "prompt_id": {"const": "qwen3-nonthinking-exact"},
        "semantic_smokes": {"const": 1}
