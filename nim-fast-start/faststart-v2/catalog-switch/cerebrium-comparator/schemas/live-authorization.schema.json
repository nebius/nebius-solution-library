      "required": ["arm_id", "cold_attempts", "cold_classification", "prompt_id", "semantic_smokes"],
      "type": "object"
    },
    "cleanup": {
      "additionalProperties": false,
      "properties": {
        "desired_final_state": {"const": "ABSENT"},
        "foreign_replacement_policy": {"const": "fail-closed-no-delete"},
        "idempotent": {"const": true},
        "partial_create_cleanup": {"const": true},
        "verification": {"const": "exact-id-not-found-plus-cascade-child-absence"}
      },
      "required": ["desired_final_state", "foreign_replacement_policy", "idempotent", "partial_create_cleanup", "verification"],
      "type": "object"
    },
    "expires_at": {"const": "2026-08-19T18:25:41Z"},
    "frozen": {
      "additionalProperties": false,
      "properties": {
        "campaign_sha256": {"const": "e6a36c56455cdb5a603eadc1d01781692899ba789a4459bc26e631b5d4d11cba"},
        "expected_cost_usd": {"const": "4.360934"},
        "image_amd64_digest": {"const": "sha256:7c2c59db86a9a64138c5c675b98e3e05b7f37a34a344d4aa461b1529ed60262d"},
        "input_sha256": {"const": "c3e3250abbb92869b7a51325a5fd5358eb98122d73698956cf064ed491d3291d"},
        "lease_plan_sha256": {"const": "e9379995eabb09ef0e44fefbd8e1a88a71505924872728ac5209c962204960c0"},
        "model_id": {"const": "Qwen/Qwen3-8B"},
        "model_revision": {"const": "b968826d9c46dd6066d109eabc6255188de91218"},
        "request_sha256": {"const": "6507dfc4df35c9b242c91f5fcf05856faa98c1cd199bb9c208dfb396998516aa"},
        "source_parent_commit": {"const": "94cd1c9999dfe7ca7626661b89352b6d41727cd4"},
        "ttl_cost_ceiling_usd": {"const": "8.721867"}
      },
      "required": ["campaign_sha256", "expected_cost_usd", "image_amd64_digest", "input_sha256", "lease_plan_sha256", "model_id", "model_revision", "request_sha256", "source_parent_commit", "ttl_cost_ceiling_usd"],
      "type": "object"
    },
    "implementation": {
      "additionalProperties": false,
      "properties": {
        "broker_path": {"const": "resource-broker/broker.py"},
        "broker_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "broker_tests_path": {"const": "resource-broker/tests/test_broker.py"},
