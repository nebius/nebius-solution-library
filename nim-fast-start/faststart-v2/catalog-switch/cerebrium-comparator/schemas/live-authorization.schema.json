    "network": {
      "additionalProperties": false,
      "properties": {
        "direct_container_ingress": {"const": false},
        "egress": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "destination_cidrs": {"const": ["0.0.0.0/0"]},
              "ports": {"items": {"maximum": 65535, "minimum": 1, "type": "integer"}, "type": "array"},
