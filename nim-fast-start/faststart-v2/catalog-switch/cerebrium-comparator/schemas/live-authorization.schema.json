  "required": ["authorization_id", "authorized_at", "authorized_by", "bearer_token_sha256", "bootstrap_artifacts", "campaign", "cleanup", "expires_at", "frozen", "implementation", "network", "scope", "schema", "secret_values_published", "state"],
  "type": "object"
}
