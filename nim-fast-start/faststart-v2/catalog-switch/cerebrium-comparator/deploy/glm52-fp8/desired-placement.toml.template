# NON-DEPLOYABLE: replace the sentinel only after the current Cerebrium project
# explicitly reports an exact private-Nebius one-node 8xH200 compute identifier.
[cerebrium.deployment]
name = "mlspec-catswitch-glm52-fp8-ba978f7"
disable_auth = false
include = ["Dockerfile", "cerebrium.toml"]
exclude = [".*", "__pycache__/*", "*.pyc"]

[cerebrium.runtime.custom]
port = 8000
dockerfile_path = "./Dockerfile"
healthcheck_endpoint = "/health"
readycheck_endpoint = "/health"

[cerebrium.hardware]
provider = "nebius"
region = "eu-north1-rsd"
compute = "EXACT_CURRENT_PROJECT_H200_COMPUTE_ID_REQUIRED"
cpu = 128
memory = 1600.0
gpu_count = 8

[cerebrium.scaling]
min_replicas = 0
max_replicas = 1
replica_concurrency = 1
cooldown = 30
response_grace_period = 3600
scaling_metric = "concurrency_utilization"
scaling_target = 100
evaluation_interval_seconds = 30
roll_out_duration_seconds = 0
