  "invariants": [
    {
      "id": "DR-INV-01",
      "statement": "Admission is open only for one exact runtime after an exact bridge receipt proves two distinct, ordered, raw-evidence-backed semantic calls executed by the canonical validator derived from the pinned source artifact and an independently reread complete off-node durable chain segment."
    },
    {
      "id": "DR-INV-02",
      "statement": "Every state mutation, physical command, request lease, and response is controller-lease- and runtime-generation-fenced; late responses are durably terminal before rejection."
    },
    {
      "id": "DR-INV-03",
      "statement": "GPU_FREE requires stop completion, exact process/cgroup/container/Pod and host-residue absence, then an approved scrub bound to the exact GPU UUID and total bytes, then exactly two NVML samples with zero compute processes, zero graphics processes, and zero used bytes."
    },
    {
      "id": "DR-INV-04",
      "statement": "The target switch begins only after a mandatory canonical verifier reconstructs an exact request.accepted receipt from the pinned trace, shared ledger, predecessor-hash audit, and off-node durable segment; every request-specific event remains causally after that immutable external-client T0."
    },
    {
      "id": "DR-INV-05",
      "statement": "Drain, timeout, reclaim, semantic validation, every admitted failure, accounting, and cleanup are durably retained in the shared denominator and hash-chained audit segment; rollback A has its own later external T0, trace, terminal, accounting, and cleanup linked to B failure."
    },
    {
      "id": "DR-INV-06",
      "statement": "Unknown cleanup quarantines the node; reuse requires placement-lease revocation, a newly created resource with a fresh boot identity, and signed requalification covering sentinel VRAM, host residue, occupancy, audit continuity, and command replay refusal."
    },
    {
      "id": "DR-INV-07",
      "statement": "Reclaim cannot begin while an active lease belongs to the retiring runtime; the bounded drain durably completes or times out every admitted lease before stop."
    },
    {
      "id": "DR-INV-08",
      "statement": "Canonical snapshots use compare-and-swap revisions whose predecessor-hash records embed every complete post-transition state detail; state restart and agent actions reject stale controller generations."
    },
    {
      "id": "DR-INV-09",
      "statement": "Every launch has a durable pre-launch operation identity and agent-side executing intent; bound and ambiguous failed launches require exact generation cleanup and GPU-zero proof before rollback or any new generation, and ambiguous commands are never replayed."
    },
    {
      "id": "DR-INV-10",
      "statement": "Exact duplicate reservations and commands are idempotent, conflicting retries are rejected, and both node-local and exact-cluster Kubernetes receiving agents fsync GPU/operation/generation occupancy before dispatch and refuse a second valid launch before its physical runner."
    }
  ],
