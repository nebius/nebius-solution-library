{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/nebius/nebius-solutions-library/nim-fast-start/faststart-v2/catalog-switch/snapshot-eligibility/schema/eligibility.schema.json",
 "title": "Catalog-switch snapshot-eligibility classification",
 "type": "object",
 "required": ["meta", "rows"],
 "additionalProperties": false,
 "properties": {
  "meta": {
   "type": "object",
   "required": [
    "artifact", "task", "catalog_version", "pins", "interfaces", "classes",
    "rules", "gates", "blockers", "class_counts", "rule_counts",
    "fleet_counts", "bionemo_nims", "newnode_zero_sample_proof",
    "fallback_policy", "canary_plan", "scope_notes"
   ],
   "additionalProperties": false,
   "properties": {
    "artifact": {"type": "string"},
    "task": {"const": "catalog-switch-snapshot-eligibility"},
    "catalog_version": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pins": {
     "type": "object",
     "required": [
      "catalog_commit", "catalog_branch", "catalog_path", "catalog_sha256",
      "catalog_schema_sha256", "threat_model_commit", "threat_model_branch",
      "threat_model_path", "threat_model_sha256", "threat_model_vendored",
      "resource_broker_commit", "resource_broker_branch",
      "request_slo_commit", "request_slo_branch"
     ],
     "additionalProperties": false,
     "properties": {
      "catalog_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "catalog_branch": {"type": "string"},
      "catalog_path": {"type": "string"},
      "catalog_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "catalog_schema_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "threat_model_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "threat_model_branch": {"type": "string"},
      "threat_model_path": {"type": "string"},
      "threat_model_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "threat_model_vendored": {"type": "string"},
      "resource_broker_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "resource_broker_branch": {"type": "string"},
      "request_slo_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "request_slo_branch": {"type": "string"}
     }
    },
    "interfaces": {
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "object",
      "required": ["path", "schema_id", "commit", "sha256"],
      "additionalProperties": false,
      "properties": {
       "path": {"type": "string", "pattern": "^nim-fast-start/faststart-v2/"},
       "schema_id": {"type": "string", "pattern": "-v1(\\.schema)?\\.json$"},
       "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
       "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
     }
    },
    "newnode_zero_sample_proof": {
     "type": "object",
     "required": [
      "path", "sha256", "sample_count", "poolable_run_ids",
      "classification", "future_execution_path", "historical_run_ids"
     ],
     "additionalProperties": false,
     "properties": {
      "path": {"type": "string"},
      "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "sample_count": {"const": 0},
      "poolable_run_ids": {"type": "array", "maxItems": 0},
      "classification": {"const": "NO_CURRENT_CONTRACT_EVIDENCE"},
      "future_execution_path": {"const": "newnode-v2-only"},
      "historical_run_ids": {"type": "array", "items": {"type": "string"}}
     }
    },
    "classes": {
     "type": "object",
     "required": [
      "direct-snapshot-safe", "snapshot-after-state-externalization",
      "conventional-only", "unresolved"
     ],
     "additionalProperties": false,
     "properties": {
      "direct-snapshot-safe": {"type": "string"},
      "snapshot-after-state-externalization": {"type": "string"},
      "conventional-only": {"type": "string"},
      "unresolved": {"type": "string"}
     }
    },
    "rules": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": ["id", "order", "condition", "class"],
      "additionalProperties": false,
      "properties": {
       "id": {"type": "string", "pattern": "^R[0-9]{2}-[a-z-]+$"},
       "order": {"type": "integer", "minimum": 1},
       "condition": {"type": "string"},
       "class": {"type": "string"}
      }
     }
    },
    "gates": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": ["id", "title", "requirement", "bindings"],
      "additionalProperties": false,
      "properties": {
       "id": {"type": "string", "pattern": "^G-[A-Z]+$"},
       "title": {"type": "string"},
       "requirement": {"type": "string"},
       "bindings": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "pattern": "^(INV|CTL)-[0-9]{2}$"}
       }
      }
     }
    },
    "blockers": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": ["id", "rule", "fail_closed_behavior", "resolution_path"],
      "additionalProperties": false,
      "properties": {
       "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
       "rule": {"type": "string"},
       "fail_closed_behavior": {"type": "string"},
       "resolution_path": {"type": "string"}
      }
     }
    },
    "class_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
    "rule_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
    "fleet_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
    "bionemo_nims": {
     "type": "array",
     "minItems": 10,
     "maxItems": 10,
     "items": {
      "type": "object",
      "required": [
       "nim", "evidence_rank", "row_id", "snapshot_class",
       "catalog_snapshot_eligibility", "confidence", "conventional_fallback",
       "storage_blockers", "topology_blockers", "cohorts"
      ],
      "additionalProperties": false,
      "properties": {
       "nim": {
        "enum": [
         "boltz2", "openfold2", "diffdock", "evo2-40b", "genmol", "molmim",
         "msa-search", "openfold3", "proteinmpnn", "rfdiffusion"
        ]
       },
       "evidence_rank": {"type": "integer", "minimum": 1, "maximum": 10},
       "row_id": {"type": "string", "pattern": "^faststart:"},
       "snapshot_class": {
        "enum": [
         "direct-snapshot-safe", "snapshot-after-state-externalization",
         "conventional-only", "unresolved"
        ]
       },
       "catalog_snapshot_eligibility": {"type": "string"},
       "confidence": {"enum": ["high", "medium", "low"]},
       "conventional_fallback": {
        "type": "object",
        "required": ["path", "admission", "measured", "measurement_refs"],
        "additionalProperties": false,
        "properties": {
         "path": {"enum": ["conventional-cached-start", "conventional-pull-and-load"]},
         "admission": {
          "enum": ["measured", "measurement-required", "blocked-until-digest-bound"]
         },
         "measured": {"type": "boolean"},
         "measurement_refs": {"type": "array", "items": {"type": "string"}}
        }
       },
       "storage_blockers": {"type": "array", "items": {"type": "string", "minLength": 10}},
       "topology_blockers": {"type": "array", "items": {"type": "string", "minLength": 10}},
       "cohorts": {
        "type": "object",
        "required": ["provisioned_node", "new_preemptible_node"],
        "additionalProperties": false,
        "properties": {
         "provisioned_node": {
          "type": "object",
          "required": [
           "status", "evidence_class", "evidence_refs", "sealed",
           "image_binding", "outcome", "outstanding_evidence_gaps",
           "further_required"
          ],
          "additionalProperties": false,
          "properties": {
           "image_binding": {
            "enum": ["in-file", "checkpoint-join", "cohort-bound-n20", "none"]
           },
           "status": {
            "enum": [
             "complete-fresh-fail-closed-n20", "complete-n3",
             "complete-n3-unsealed", "complete-n3-conventional",
             "missing-production-shaped"
            ]
           },
           "evidence_class": {"type": ["string", "null"]},
           "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/bound_ref"}
           },
           "sealed": {"type": "boolean"},
           "outcome": {
            "anyOf": [
             {"type": "null"},
             {
              "type": "object",
              "required": [
               "slo_threshold_s", "slo_pass", "t0_to_call2_p50_s",
               "t0_to_call2_p95_s", "boottime_upper_p50_s",
               "boottime_upper_p95_s", "note"
              ],
              "additionalProperties": false,
              "properties": {
               "slo_threshold_s": {"const": 30.0},
               "slo_pass": {"type": ["boolean", "null"]},
               "t0_to_call2_p50_s": {"type": "number"},
               "t0_to_call2_p95_s": {"type": ["number", "null"]},
               "boottime_upper_p50_s": {"type": ["number", "null"]},
               "boottime_upper_p95_s": {"type": ["number", "null"]},
               "note": {"type": ["string", "null"]}
              }
             }
            ]
           },
           "outstanding_evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 20}},
           "further_required": {"type": "string", "minLength": 20}
          }
         },
         "new_preemptible_node": {
          "type": "object",
          "required": [
           "status", "min_accepted_samples", "per_scenario", "required",
           "requested_via", "historical_note", "evidence_refs"
          ],
          "additionalProperties": false,
          "properties": {
           "status": {"enum": ["required-not-run", "blocked-hardware-gate-h200"]},
           "min_accepted_samples": {"type": "integer", "minimum": 20},
           "per_scenario": {"const": true},
           "required": {"type": "string", "minLength": 20},
           "requested_via": {
            "type": "object",
            "required": ["resource_broker", "request_slo_harness"],
            "additionalProperties": false,
            "properties": {
             "resource_broker": {"type": "string"},
             "request_slo_harness": {"type": "string"}
            }
           },
           "historical_note": {"type": ["string", "null"]},
           "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/bound_ref"}}
          }
         }
        }
       }
      }
     }
    },
    "fallback_policy": {
     "type": "object",
     "required": ["statement", "admission_values"],
     "additionalProperties": false,
     "properties": {
      "statement": {"type": "string"},
      "admission_values": {"type": "object", "additionalProperties": {"type": "string"}}
     }
    },
    "canary_plan": {
     "type": "object",
     "required": ["process", "entries", "deferred"],
     "additionalProperties": false,
     "properties": {
      "process": {"type": "string"},
      "entries": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "canary_id", "purpose", "row_id", "snapshot_attempt_allowed",
         "requested_via", "status"
        ],
        "additionalProperties": false,
        "properties": {
         "canary_id": {"type": "string", "pattern": "^canary-[a-z0-9-]+$"},
         "purpose": {"type": "string"},
         "row_id": {"type": "string"},
         "snapshot_attempt_allowed": {"type": "boolean"},
         "requested_via": {
          "type": "object",
          "required": ["resource_broker", "request_slo_harness"],
          "additionalProperties": false,
          "properties": {
           "resource_broker": {"type": "string"},
           "request_slo_harness": {"type": "string"}
          }
         },
         "status": {"const": "requested-not-run"}
        }
       }
      },
      "deferred": {
       "type": "array",
       "items": {
        "type": "object",
        "required": ["row_id", "reason", "status"],
        "additionalProperties": false,
        "properties": {
         "row_id": {"type": "string"},
         "reason": {"type": "string"},
         "status": {"const": "deferred-not-requested"}
        }
       }
      }
     }
    },
    "scope_notes": {"type": "array", "items": {"type": "string"}}
   }
  },
  "rows": {
   "type": "array",
   "minItems": 1,
   "items": {"$ref": "#/$defs/row"}
  }
 },
 "$defs": {
  "bound_ref": {
   "type": "object",
   "required": ["path", "sha256"],
   "additionalProperties": false,
   "properties": {
    "path": {"type": "string", "pattern": "^nim-fast-start/faststart-v2/"},
    "sha256": {
     "anyOf": [
      {"type": "null"},
      {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
     ]
    }
   }
  },
  "row": {
   "type": "object",
   "required": [
    "id", "canonical_key", "name", "source", "catalog", "fleet_status",
    "snapshot_class", "decision_rule", "confidence", "evidence",
    "storage_bound", "blockers", "promotion_gates", "fallback", "canary_ids"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "minLength": 3},
    "canonical_key": {"type": "string", "minLength": 3},
    "name": {"type": "string", "minLength": 1},
    "source": {
     "enum": [
      "forge-manifests", "faststart-v2-lanes", "nims-terraform-catalog",
      "documented-candidates"
     ]
    },
    "catalog": {
     "type": "object",
     "required": [
      "availability_class", "availability_gates", "snapshot_eligibility",
      "startup_path", "runtime_family", "multi_gpu_required", "min_gpus",
      "image_digest", "registry_visibility", "tag_pinned",
      "local_bytes_known", "validator"
     ],
     "additionalProperties": false,
     "properties": {
      "availability_class": {"enum": ["verified", "discoverable", "gated", "hypothetical"]},
      "availability_gates": {"type": "array", "items": {"type": "string"}},
      "snapshot_eligibility": {
       "enum": [
        "proven", "candidate-family-proven", "candidate-unproven",
        "unproven-multi-gpu", "excluded", "blocked-pending-capture",
        "not-applicable"
       ]
      },
      "startup_path": {
       "enum": [
        "native-snapshot-restore", "conventional-cached-start",
        "conventional-pull-and-load", "notebook", "unknown"
       ]
      },
      "runtime_family": {"type": "string"},
      "multi_gpu_required": {"type": ["boolean", "null"]},
      "min_gpus": {"type": ["integer", "null"]},
      "image_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
      "registry_visibility": {"enum": ["public", "private-mirror", "local-build", "unknown"]},
      "tag_pinned": {"type": ["boolean", "null"]},
      "local_bytes_known": {"type": "integer", "minimum": 0},
      "validator": {"type": ["string", "null"]}
     }
    },
    "fleet_status": {"enum": ["active", "excluded-non-serving", "excluded-hypothetical"]},
    "snapshot_class": {
     "enum": [
      "direct-snapshot-safe", "snapshot-after-state-externalization",
      "conventional-only", "unresolved"
     ]
    },
    "decision_rule": {"type": "string", "pattern": "^R[0-9]{2}-[a-z-]+$"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "evidence": {
     "type": "object",
     "required": ["tier", "refs", "detail"],
     "additionalProperties": false,
     "properties": {
      "tier": {"enum": ["measured-local", "measured-source", "catalog-listed", "referenced-only"]},
      "refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "detail": {"type": "string", "minLength": 10}
     }
    },
    "storage_bound": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9:-]+$"}},
    "promotion_gates": {
     "type": "array",
     "minItems": 1,
     "items": {"type": "string", "pattern": "^G-[A-Z]+$"}
    },
    "fallback": {
     "type": "object",
     "required": ["path", "admission", "measured", "measurement_refs", "measurement_owner"],
     "additionalProperties": false,
     "properties": {
      "path": {"enum": ["conventional-cached-start", "conventional-pull-and-load"]},
      "admission": {
       "enum": [
        "measured", "measurement-required", "blocked-until-digest-bound",
        "excluded"
       ]
      },
      "measured": {"type": "boolean"},
      "measurement_refs": {"type": "array", "items": {"type": "string"}},
      "measurement_owner": {"type": "string"}
     }
    },
    "canary_ids": {"type": "array", "items": {"type": "string"}}
   }
  }
 }
}
