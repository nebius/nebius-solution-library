{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/nebius/nebius-solutions-library/nim-fast-start/faststart-v2/catalog/schema/catalog.schema.json",
 "title": "Catalog-switch model inventory",
 "type": "object",
 "required": ["meta", "rows"],
 "additionalProperties": false,
 "properties": {
  "meta": {
   "type": "object",
   "required": ["catalog_version", "sources", "row_counts", "family_taxonomy", "pilots", "storage_feasibility"],
   "additionalProperties": false,
   "properties": {
    "catalog_version": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "row_counts": {
     "type": "object",
     "required": ["total", "by_availability", "by_source", "unique_canonical_models"],
     "properties": {
      "total": {"type": "integer", "minimum": 1},
      "by_availability": {"type": "object"},
      "by_source": {"type": "object"},
      "unique_canonical_models": {"type": "integer", "minimum": 1}
     }
    },
    "family_taxonomy": {"type": "array", "items": {"type": "object", "required": ["workload_class", "runtime_family", "row_count"], "properties": {"workload_class": {"type": "string"}, "runtime_family": {"type": "string"}, "row_count": {"type": "integer"}}}},
    "pilots": {
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "object",
      "required": ["pilot_class", "selection_rule", "selected_id", "alternate_id"],
      "properties": {
       "pilot_class": {"enum": ["small-snapshot-friendly", "storage-heavy", "large-or-multi-gpu"]},
       "selection_rule": {"type": "string"},
       "selected_id": {"type": "string"},
       "alternate_id": {"type": ["string", "null"]},
       "caveats": {"type": "array", "items": {"type": "string"}}
      }
     }
    },
    "storage_feasibility": {
     "type": "object",
     "required": ["known_local_bytes_total", "rows_fully_sized", "rows_partially_sized", "rows_unsized", "estimated_total_bytes_low", "estimated_total_bytes_high", "method"],
     "properties": {
      "known_local_bytes_total": {"type": "integer", "minimum": 0},
      "rows_fully_sized": {"type": "integer"},
      "rows_partially_sized": {"type": "integer"},
      "rows_unsized": {"type": "integer"},
      "estimated_total_bytes_low": {"type": "integer"},
      "estimated_total_bytes_high": {"type": "integer"},
      "method": {"type": "string"}
     }
    }
   }
  },
  "rows": {
   "type": "array",
   "minItems": 1,
   "items": {"$ref": "#/$defs/row"}
  }
 },
 "$defs": {
  "row": {
   "type": "object",
   "required": ["id", "canonical_key", "name", "version_id", "source", "provenance", "availability", "workload", "api", "gpu", "image", "artifact", "startup", "snapshot", "license", "fixtures", "storage", "related_ids"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^(forge|faststart|nims-terraform|documented):[a-z0-9][a-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "canonical_key": {"type": "string", "minLength": 3},
    "name": {"type": "string", "minLength": 1},
    "version_id": {"type": "string", "minLength": 1},
    "source": {"enum": ["forge-manifests", "faststart-v2-lanes", "nims-terraform-catalog", "documented-candidates"]},
    "provenance": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": ["source", "path"],
      "properties": {
       "source": {"type": "string"},
       "path": {"type": "string"},
       "ref": {"type": ["string", "null"]},
       "detail": {"type": ["string", "null"]}
      }
     }
    },
    "availability": {
     "type": "object",
     "required": ["class", "evidence_tier", "confidence", "gates"],
     "additionalProperties": false,
     "properties": {
      "class": {"enum": ["verified", "discoverable", "gated", "hypothetical"]},
      "evidence_tier": {"enum": ["measured-local", "measured-source", "catalog-listed", "referenced-only"]},
      "confidence": {"enum": ["high", "medium", "low"]},
      "gates": {"type": "array", "items": {"type": "string"}},
      "evidence": {"type": ["string", "null"]}
     }
    },
    "workload": {
     "type": "object",
     "required": ["workload_class", "category"],
     "properties": {
      "workload_class": {"type": "string"},
      "category": {"type": ["string", "null"]},
      "tags": {"type": "array", "items": {"type": "string"}},
      "modality_input": {"type": "array", "items": {"type": "string"}},
      "modality_output": {"type": "array", "items": {"type": "string"}},
      "parameter_count": {"type": ["integer", "null"]}
     }
    },
    "api": {
     "type": "object",
     "required": ["style", "endpoint_path"],
     "properties": {
      "style": {"enum": ["openai-compatible", "nim-native-http", "custom-http", "notebook", "unknown"]},
      "endpoint_path": {"type": ["string", "null"]},
      "method": {"type": ["string", "null"]},
      "context_window": {"type": ["integer", "null"]}
     }
    },
    "gpu": {
     "type": "object",
     "required": ["min_gpus", "min_vram_gb", "sku_compatibility", "sku_evidence", "multi_gpu_required"],
     "properties": {
      "min_gpus": {"type": ["integer", "null"], "minimum": 1},
      "min_vram_gb": {"type": ["number", "null"]},
      "sku_compatibility": {"type": ["object", "null"], "additionalProperties": {"type": "boolean"}},
      "sku_evidence": {"type": ["string", "null"]},
      "multi_gpu_required": {"type": ["boolean", "null"]},
      "cpu": {"type": ["number", "null"]},
      "memory_gi": {"type": ["number", "null"]},
      "shm_gi": {"type": ["number", "null"]}
     }
    },
    "image": {
     "type": "object",
     "required": ["upstream_ref", "digest", "size_bytes", "registry_visibility"],
     "properties": {
      "upstream_ref": {"type": ["string", "null"]},
      "digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
      "size_bytes": {"type": ["integer", "null"]},
      "registry_visibility": {"enum": ["public", "private-mirror", "local-build", "unknown"]},
      "mirror_regions": {"type": "array", "items": {"type": "string"}},
      "tag_pinned": {"type": ["boolean", "null"]}
     }
    },
    "artifact": {
     "type": "object",
     "required": ["size_bytes", "gated", "requires_hf_token"],
     "properties": {
      "size_bytes": {"type": ["integer", "null"]},
      "cache_bytes": {"type": ["integer", "null"]},
      "gated": {"type": ["boolean", "null"]},
      "private": {"type": ["boolean", "null"]},
      "requires_hf_token": {"type": ["boolean", "null"]},
      "revision": {"type": ["string", "null"]},
      "artifact_id": {"type": ["string", "null"]},
      "note": {"type": ["string", "null"]}
     }
    },
    "startup": {
     "type": "object",
     "required": ["path", "runtime_family"],
     "properties": {
      "path": {"enum": ["native-snapshot-restore", "conventional-cached-start", "conventional-pull-and-load", "notebook", "unknown"]},
      "runtime_family": {"type": "string"},
      "writable_state": {"type": ["string", "null"]},
      "external_mounts": {"type": "array", "items": {"type": "string"}},
      "measured": {
       "type": ["object", "null"],
       "properties": {
        "evidence_class": {"type": "string"},
        "storage_state": {"type": "string"},
        "t0_to_http_ready_p50_s": {"type": ["number", "null"]},
        "t0_to_call2_p50_s": {"type": ["number", "null"]},
        "t0_to_call2_p95_s": {"type": ["number", "null"]},
        "slo_under_30s": {"type": ["boolean", "null"]}
       }
      }
     }
    },
    "snapshot": {
     "type": "object",
     "required": ["eligibility", "confidence"],
     "properties": {
      "eligibility": {"enum": ["proven", "candidate-family-proven", "candidate-unproven", "unproven-multi-gpu", "excluded", "blocked-pending-capture", "not-applicable"]},
      "confidence": {"enum": ["high", "medium", "low"]},
      "evidence": {"type": ["string", "null"]}
     }
    },
    "license": {
     "type": "object",
     "required": ["id"],
     "properties": {
      "id": {"type": ["string", "null"]},
      "caveats": {"type": "array", "items": {"type": "string"}}
     }
    },
    "fixtures": {
     "type": "object",
     "required": ["status"],
     "properties": {
      "status": {"enum": ["linked-strict-validator", "example-only", "missing"]},
      "validator_path": {"type": ["string", "null"]},
      "fixture_paths": {"type": "array", "items": {"type": "string"}}
     }
    },
    "storage": {
     "type": "object",
     "required": ["local_bytes_known", "unknown_components"],
     "properties": {
      "local_bytes_known": {"type": "integer", "minimum": 0},
      "unknown_components": {"type": "array", "items": {"type": "string"}}
     }
    },
    "related_ids": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
   }
  }
 }
}
